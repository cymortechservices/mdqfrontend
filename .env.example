# Copy to .env (never commit .env). Everything here is PUBLIC: values prefixed with
# VITE_ are embedded in the browser bundle. Never put secrets in this file.

# Base URL of the MDQ API. Leave EMPTY (recommended) to call the same origin as the
# page, which is how the current production site works (cookies just work).
# If you set a different origin, the backend must allow credentialed CORS for the
# site origin and issue cookies with SameSite=None; Secure.
VITE_API_BASE_URL=

# --- Local development only (not embedded in the bundle) -------------------------
# Forward API calls from `npm run dev` / `npm run preview` to a running backend.
# MDQ_DEV_API_TARGET=http://localhost:3000
